# Tilx — Environment Variables
# Copy this to .env.local and fill in values. Never commit .env.local to git.

# Firebase Cloud Function base URL
# Development (Firebase emulator):
EXPO_PUBLIC_API_URL=http://localhost:5001/<YOUR_PROJECT_ID>/us-central1

# Production (set via EAS Build environment):
# EXPO_PUBLIC_API_URL=https://us-central1-<YOUR_PROJECT_ID>.cloudfunctions.net
